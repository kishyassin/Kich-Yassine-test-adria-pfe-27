enum AccountStatus {
    ACTIVE
    BLOCKED
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

input AccountInput {
    customerReference: String!
    status: AccountStatus
    currency: String!
    balance: Float!
}

type Query {
    accounts: [Account]!
    accountById(id: ID!): Account
}

type Mutation {
    addAccount(account: AccountInput!): Account!
    debitAccount(id: ID!, amount: Float!, currency: String): Account!
    creditAccount(id: ID!, amount: Float!, currency: String): Account!
}
